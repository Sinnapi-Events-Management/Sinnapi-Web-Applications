# Public Supabase config (safe to expose — anon key + project URL only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Cloudflare Turnstile widget (site key is public by design; the matching
# secret lives only in the Edge Functions' env as TURNSTILE_SECRET)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# This site's own canonical origin: canonical URLs, sitemap, robots, OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The authenticated portals, which are separate apps on separate origins.
# Public CTAs deep-link into them (e.g. a vendor profile's "Request a quote"
# opens that vendor in the client portal, which handles sign-in itself).
# Server-only by design: no NEXT_PUBLIC_ prefix, so these never reach the
# browser bundle — a client component needs the value passed down as a prop.
# Unset means those CTAs fall back to this site's /sign-in role chooser.
NEXT_CLIENT_PORTAL_URL=http://localhost:3001
NEXT_VENDORS_PORTAL_URL=http://localhost:3002
