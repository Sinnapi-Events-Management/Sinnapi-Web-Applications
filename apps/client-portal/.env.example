# Vite exposes only VITE_-prefixed vars to the client (anon key is safe by design)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Cloudflare Turnstile widget (site key is public by design; the matching
# secret lives only in the Edge Functions' env as TURNSTILE_SECRET)
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Public marketing site (for "back to site" links)
VITE_PUBLIC_URL=http://localhost:3000
