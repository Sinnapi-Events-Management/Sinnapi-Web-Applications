{
  "name": "@sinnapi/utils",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./constants.ts",
    "./constants": "./constants.ts",
    "./userAgent": "./userAgent.ts",
    "./download": "./download.ts",
    "./quotationPdf": "./quotationPdf/index.ts"
  },
  "scripts": {
    "lint": "eslint . --ext ts,tsx",
