# Sinnapi Edge Functions — environment
#
# Local:  copy to supabase/functions/.env (git-ignored). `supabase functions
#         serve` loads that file by default.
# Hosted: `supabase secrets set KEY=value KEY2=value …` on the linked project.
#         Never commit real values; this file holds shapes and public
#         endpoints only.
#
# Runbook, including the one-off Pesapal IPN registration and when it has to
# be repeated: supabase/pre-requist.md.

# ─────────────────────────────────────────────────────────────────────────────
# Pesapal (API 3.0)  — MTN MoMo, Airtel Money, cards. Read by _shared/pesapal.ts
# ─────────────────────────────────────────────────────────────────────────────

# API base. The code defaults to LIVE when unset, so sandbox must be explicit.
#   sandbox: https://cybqa.pesapal.com/pesapalv3
#   live:    https://pay.pesapal.com/v3
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3

# Merchant credentials. They are per environment: a sandbox pair is refused
# by the live API and vice versa.
#   sandbox: Pesapal publishes demo merchant keys per country at
#            https://developer.pesapal.com/api3-demo-keys.txt — use the UGX
#            (Uganda) merchant so mobile-money rails are available.
#   live:    Pesapal merchant dashboard → Integrations → API keys (the account
#            Sinnapi's KYC was approved on).
PESAPAL_CONSUMER_KEY=TDpigBOOhs+zAl8cwH2Fl82jJGyD8xev
PESAPAL_CONSUMER_SECRET=1KpqkfsMaihIcOlhnBo/gBZ5smw=

# The id Pesapal gave us when we registered the webhook URL with RegisterIPN.
# NOT a URL. Obtain it with `yarn pesapal:ipn` (scripts/register-pesapal-ipn.mjs),
# which prints it and the registered list. It is bound to ONE environment and
# ONE exact URL, so it has to be re-obtained whenever either changes
# (project ref, custom domain, sandbox ↔ live). A stale id fails silently:
# checkouts succeed, no IPN ever arrives, escrow is never funded.
#   sandbox: the id printed by `yarn pesapal:ipn --env sandbox --project-ref <ref>`
#   live:    the id printed by `yarn pesapal:ipn --env live --project-ref <ref>`
PESAPAL_IPN_ID=

# Where the BROWSER is sent after the hosted checkout page — the client
# portal's return route, which reads the outcome from our own database.
# Must be the client portal's public origin for the environment (and that
# origin must also be in ALLOWED_ORIGINS below).
#   local:   http://localhost:3001/payments/return
#   live:    https://app.sinnapi.com/payments/return
#   Subscription checkouts (opened from the vendor portal) override this per
#   order with VENDOR_PORTAL_URL + /payments/return, so the vendor lands back
#   in their own portal. VENDOR_PORTAL_URL is set below; if it is unset the
#   vendor is sent here instead, which the client portal's return page can
#   still make sense of.
PESAPAL_CALLBACK_URL=http://localhost:3001/payments/return

# ─────────────────────────────────────────────────────────────────────────────
# PayPal (Orders v2)  — cards / PayPal balance. Read by _shared/paypal.ts
# ─────────────────────────────────────────────────────────────────────────────

# API base. Defaults to LIVE when unset.
#   sandbox: https://api-m.sandbox.paypal.com
#   live:    https://api-m.paypal.com
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# REST app credentials, per environment.
#   sandbox: developer.paypal.com → Apps & Credentials → Sandbox → your app
#   live:    developer.paypal.com → Apps & Credentials → Live → your app
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Webhook id from developer.paypal.com → your app → Webhooks, for the
# webhook whose URL is https://<project-ref>.supabase.co/functions/v1/psp-paypal-webhook
# subscribed to PAYMENT.CAPTURE.* and CHECKOUT.ORDER.*. Used to verify
# signatures; per environment and per URL, like the Pesapal IPN id.
PAYPAL_WEBHOOK_ID=

# Where PayPal sends the browser after approve / cancel. No route in any
# portal serves these yet (only the Pesapal return is built); set them to the
# client portal's booking list so a client at least lands somewhere sensible.
#   local:   http://localhost:3001/bookings
#   live:    https://app.sinnapi.com/bookings
PAYPAL_RETURN_URL=http://localhost:3001/bookings
PAYPAL_CANCEL_URL=http://localhost:3001/bookings

# ─────────────────────────────────────────────────────────────────────────────
# Related
# ─────────────────────────────────────────────────────────────────────────────

# Browser origins allowed to call the functions (create-payment is called from
# the client portal). Fails closed: unset means no browser can call anything.
#   local:   http://localhost:3001,http://localhost:3002,http://localhost:3003
#   live:    https://app.sinnapi.com,<vendor portal origin>,<admin portal origin>
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

# ─────────────────────────────────────────────────────────────────────────────
# Everything else the functions read. Plain values, no registration step.
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by
# the runtime (hosted) and by `supabase functions serve` (local) — do not put
# them here; the CLI refuses SUPABASE_-prefixed keys in this file.
# ─────────────────────────────────────────────────────────────────────────────

# Brand and public origins used in every email the functions send. Portal
# URLs fall back to PUBLIC_SITE_URL, which is wrong for links into a portal.
#   local:   http://localhost:3001 / :3002 / :3003
#   live:    https://app.sinnapi.com / <vendor portal origin> / <admin portal origin>
APP_NAME=Sinnapi
PUBLIC_SITE_URL=https://sinnapi.com
CLIENT_PORTAL_URL=http://localhost:3001
VENDOR_PORTAL_URL=http://localhost:3002
ADMIN_PORTAL_URL=http://localhost:3003
# Only for a custom domain in front of the functions (newsletter unsubscribe
# links); otherwise derived from SUPABASE_URL.
FUNCTIONS_BASE_URL=
EMAIL_LOGO_URL=
COMPANY_LEGAL_NAME=Sinnapi Events Management Ltd
COMPANY_POSTAL_ADDRESS=Kampala, Uganda

# Cloudflare Turnstile secret paired with the site key the apps ship
# (VITE_TURNSTILE_SITE_KEY / NEXT_PUBLIC_TURNSTILE_SITE_KEY). Fails closed:
# unset means portal-sign-in, client-sign-up, vendor-application and
# send-password-reset refuse every anonymous request.
TURNSTILE_SECRET=
CONFIRM_LINK_EXPIRY_HOURS=24
RESET_LINK_EXPIRY_HOURS=24
# Internal mailbox that receives a copy of each vendor application.
VENDOR_APPLICATIONS_INBOX=

# Transactional email (_shared/email.ts, SMTP). SMTP_SERVERNAME only when the
# host's TLS certificate does not carry the hostname dialled — see the
# "Newsletter SMTP — TLS certificate name" note in supabase/pre-requist.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SERVERNAME=
EMAIL_FROM=
# notification-dispatch sends through an HTTP email API instead; Resend by
# default. EMAIL_API_KEY unset means notifications are recorded but not emailed.
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=

# Newsletter campaigns (_shared/campaignTransport.ts). Transport is chosen
# explicitly with NEWSLETTER_TRANSPORT=smtp|resend, else Resend when
# RESEND_API_KEY + NEWSLETTER_FROM are set, else SMTP. NEWSLETTER_SMTP_* fall
# back to the SMTP_* values above when unset.
NEWSLETTER_TRANSPORT=
NEWSLETTER_FROM=
NEWSLETTER_FROM_NAME=
NEWSLETTER_REPLY_TO=support@sinnapi.com
NEWSLETTER_UNSUBSCRIBE_MAILTO=
NEWSLETTER_SMTP_HOST=
NEWSLETTER_SMTP_PORT=
NEWSLETTER_SMTP_USER=
NEWSLETTER_SMTP_PASS=
NEWSLETTER_SMTP_SERVERNAME=
NEWSLETTER_SMTP_FROM=
RESEND_API_KEY=
# Signing secret of the Resend webhook that points at newsletter-webhook.
RESEND_WEBHOOK_SECRET=

# Scheduled jobs and moderation.
FX_API_URL=https://api.exchangerate.host/latest
# Comma-separated words content-moderation flags.
PROFANITY_LIST=
